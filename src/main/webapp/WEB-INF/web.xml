<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                      http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <servlet>
        <servlet-name>FrontContoller</servlet-name>
        <servlet-class>ru.rsreu.golyashhuk.FrontController</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>FrontContoller</servlet-name>
        <url-pattern>/controller</url-pattern>
    </servlet-mapping>

    <session-config>
        <session-timeout>1</session-timeout>
    </session-config>

    <listener>
        <listener-class>ru.rsreu.golyashhuk.listeners.SessionListener</listener-class>
    </listener>

    <listener>
        <listener-class>ru.rsreu.golyashhuk.listeners.ContextListener</listener-class>
    </listener>

    <listener>
        <listener-class>ru.rsreu.golyashhuk.listeners.SessionUserAttributeListener</listener-class>
    </listener>

    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>ru.rsreu.golyashhuk.filters.EncodingFilter</filter-class>
    </filter>

    <filter>
        <filter-name>AuthorizedFilter</filter-name>
        <filter-class>ru.rsreu.golyashhuk.filters.AuthorizedFilter</filter-class>
    </filter>

    <filter>
        <filter-name>BlockFilter</filter-name>
        <filter-class>ru.rsreu.golyashhuk.filters.BlockFilter</filter-class>
    </filter>

    <filter>
        <filter-name>AccessFilter</filter-name>
        <filter-class>ru.rsreu.golyashhuk.filters.AccessFilter</filter-class>
    </filter>

    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <servlet-name>FrontContoller</servlet-name>
    </filter-mapping>

    <filter-mapping>
        <filter-name>AuthorizedFilter</filter-name>
        <servlet-name>FrontContoller</servlet-name>
        <url-pattern>/home/*</url-pattern>
    </filter-mapping>

    <filter-mapping>
        <filter-name>BlockFilter</filter-name>
        <servlet-name>FrontContoller</servlet-name>
    </filter-mapping>

    <filter-mapping>
        <filter-name>AccessFilter</filter-name>
        <servlet-name>FrontContoller</servlet-name>
    </filter-mapping>

</web-app>